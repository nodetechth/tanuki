{
  "name": "tanuki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mobile:install": "npm install --prefix apps/mobile",
    "mobile:start": "npm run start --prefix apps/mobile",
    "mobile:ios": "npm run ios --prefix apps/mobile",
    "mobile:android": "npm run android --prefix apps/mobile",
    "mobile:dev-build:ios": "cd apps/mobile && npx eas build --profile development --platform ios",
    "mobile:dev-build:ios-simulator": "cd apps/mobile && npx eas build --profile development-simulator --platform ios",
    "mobile:dev-build:android": "cd apps/mobile && npx eas build --profile development --platform android",
    "mobile:typecheck": "npx tsc --noEmit --project apps/mobile/tsconfig.json",
    "tts:eval": "node scripts/tts-eval/generate.mjs",
    "tts:articles": "node scripts/content/generate-article-audio.mjs",
    "tts:listening:elevenlabs": "node scripts/content/generate-elevenlabs-listening-audio.mjs",
    "db:validate-listening-articles": "node scripts/content/upsert-listening-articles.mjs --strict true",
    "db:upsert-listening-articles": "node scripts/content/upsert-listening-articles.mjs",
    "db:upsert-words": "node scripts/content/upsert-word-dictionary.mjs",
    "db:check-word-examples": "node scripts/content/upsert-word-dictionary.mjs --check-db true",
    "db:word-requests": "node scripts/content/manage-word-requests.mjs",
    "db:admin-users": "node scripts/supabase/manage-admin-users.mjs",
    "audio:check-delivery": "node scripts/content/check-audio-delivery.mjs",
    "db:check-schema": "node scripts/supabase/check-schema.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "lucide-react": "^1.14.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.49.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0",
    "wink-lemmatizer": "^3.0.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
